import tkinter as tk
from tkinter import messagebox
import time

class Documento:
    def __init__(self, nombre, paginas, tiempo):
        self.nombre = nombre
        self.paginas = paginas
        self.tiempo = tiempo


class Simulador:
    def __init__(self, root):
        self.root = root
        self.root.title("Controlador de Impresión")
        self.root.geometry("400x300")

        self.cola = []

        # Entradas
        tk.Label(root, text="Nombre").pack()
        self.nombre = tk.Entry(root)
        self.nombre.pack()

        tk.Label(root, text="Páginas").pack()
        self.paginas = tk.Entry(root)
        self.paginas.pack()

        tk.Label(root, text="Tiempo por página").pack()
        self.tiempo = tk.Entry(root)
        self.tiempo.pack()

        # Botones
        tk.Button(root, text="Agregar", command=self.agregar).pack()
        tk.Button(root, text="Imprimir", command=self.imprimir).pack()

        # Estado
        self.estado = tk.Label(root, text="Sin documentos")
        self.estado.pack()

        self.detalle = tk.Label(root, text="Página: 0/0")
        self.detalle.pack()

    def agregar(self):
        try:
            doc = Documento(
                self.nombre.get(),
                int(self.paginas.get()),
                float(self.tiempo.get())
            )
            self.cola.append(doc)
            messagebox.showinfo("Info", "Agregado")
        except:
            messagebox.showerror("Error", "Datos inválidos")

    def imprimir(self):
        if len(self.cola) == 0:
            self.estado.config(text="No hay documentos")
            return

        while len(self.cola) > 0:
            doc = self.cola.pop(0)
            self.estado.config(text=f"Imprimiendo {doc.nombre}")

            for i in range(1, doc.paginas + 1):
                self.detalle.config(text=f"Página {i}/{doc.paginas}")
                self.root.update()  # Actualiza la interfaz
                time.sleep(doc.tiempo)

        self.estado.config(text="Sin documentos")
        self.detalle.config(text="Página: 0/0")


root = tk.Tk()
app = Simulador(root)
root.mainloop()
